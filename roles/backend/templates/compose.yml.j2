version: '3'
services:
  backend:
    image: {{ backend_image }}
    container_name: backend
    expose:
      - "8080"
    environment:
      - SPRING_DATA_MONGODB_URI=mongodb://{{ mongo_user }}:{{ mongo_password }}@mongodb:{{ mongo_port }}/{{ mongo_db }}?authSource=admin
    restart: always
    networks:
      - myapp-network

networks:
  myapp-network:
    external: true
    name: myapp-network