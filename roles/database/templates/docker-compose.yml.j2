version: '3'
services:
  mongodb:
    image: {{ mongo_image }}
    ports:
      - "{{ mongo_port }}:{{ mongo_port }}"
    environment:
      - MONGO_INITDB_DATABASE={{ mongo_db }}
      - MONGO_INITDB_ROOT_USERNAME={{ mongo_root_username }}
      - MONGO_INITDB_ROOT_PASSWORD={{ mongo_root_password }}
    restart: always
    networks:
      - myapp-network

networks:
    myapp-network:
        external: true
        name: myapp-network
    
    