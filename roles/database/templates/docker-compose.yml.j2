version: '3'
services:
  mongodb:
    image: mongo:latest
    container_name: mongodb
    expose:
      - "27017"
    environment:
      - MONGO_INITDB_ROOT_USERNAME={{ mongo_root_username }}
      - MONGO_INITDB_ROOT_PASSWORD={{ mongo_root_password }}
    restart: always
    networks:
      - myapp-network

networks:
  myapp-network:
    external: true
