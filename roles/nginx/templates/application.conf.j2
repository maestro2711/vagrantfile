server {
    listen 80;
    listen [::]:80;

    access_log /var/log/nginx/{{ item }}-access.log;
    error_log /var/log/nginx/{{ item }}-error.log;   

    server_name {{ item }}.local;

    root /var/www/{{ item}};
    index index.html;

    location / {
         try_files $uri $uri/ =404;
    }
}